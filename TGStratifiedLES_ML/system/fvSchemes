FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         backward;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    div(phi,U)              Gauss linearUpwind grad(U);
    div(phi,T)              Gauss linearUpwind grad(T);
    div(phi,k)              Gauss upwind;
    div(phi,epsilon)        Gauss upwind;
    div((nuEff*dev2(T(grad(U))))) Gauss linear;   // viscous term
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

