FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// Kinematic viscosity (ν)
nu              nu   [0 2 -1 0 0 0 0] 0.003927;

// Thermal expansion coefficient (β)
beta            beta [0 0 0 -1 0 0 0] 3.3e-3;   // 1/K

// Reference temperature for Boussinesq buoyancy term
TRef            TRef [0 0 0 1 0 0 0] 300;       // K

// Molecular Prandtl number (ν/α)
Pr              Pr   [0 0 0 0 0 0 0] 0.71;      // Air ~0.71, Water ~7.0

// Turbulent Prandtl number (νt/αt)
Prt             Prt  [0 0 0 0 0 0 0] 0.85;      // Common LES default

// ************************************************************************* //
