FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//simulationType  LES;
simulationType  laminar;

// LES model configuration
LES
{
    LESModel        Smagorinsky;
    delta           cubeRootVol;
    printCoeffs     on;

    SmagorinskyCoeffs
    {
        Cs      0.1;
        Prt     0.85;
    }
}

